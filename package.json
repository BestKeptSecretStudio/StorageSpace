	},
	"devDependencies": {
		"@typescript/native-preview": "^7.0.0-dev.20260215.1",
		"bun-plugin-svgr": "^0.1.0",
		"bun-plugin-tailwind": "^0.1.2",
		"bun-types": "^1.3.5",
		"clsx": "^2.1.1",
		"oxfmt": "^0.32.0",
		"oxlint": "^1.47.0",
		"oxlint-tsgolint": "^0.13.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18"
