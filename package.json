{
	"name": "storage-space",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun run index.html",
		"build": "bun run build.ts",
		"start": "bun run dist/index.html",
		"typecheck": "tsgo --noEmit",
